# Скопируй в .env и подставь свою строку подключения к PostgreSQL.
# Локально (как в песочнице):
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Neon (бесплатный серверный Postgres) — выглядит так:
# DATABASE_URL=postgresql://user:password@ep-xxxx-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Внутри docker-compose строку задаёт сам compose:
# DATABASE_URL=postgresql://postgres:kitsune_secret@db:5432/app_db

# Пароль для БД в docker-compose (можно оставить как есть для локального запуска)
POSTGRES_PASSWORD=kitsune_secret
